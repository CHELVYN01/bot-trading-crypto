# ==========================================
# KONFIGURASI HFT TRADING BOT (TEMPLATE)
# Salin file ini menjadi .env dan isi nilainya
# ==========================================

# 1. EXCHANGE (TOKOCRYPTO)
TOKOCRYPTO_API_KEY=masukkan_api_key_disini
TOKOCRYPTO_SECRET_KEY=masukkan_secret_key_disini

# 2. TELEGRAM (TELOXIDE)
TELOXIDE_TOKEN=masukkan_token_bot_telegram_disini
TELEGRAM_ADMIN_CHAT_ID=masukkan_id_chat_admin_disini

# 3. TRADING PARAMETERS
INITIAL_BUDGET_IDR=500000
MAX_RISK_PER_TRADE_PERCENT=1.0
ATR_STOP_LOSS_MULTIPLIER=1.5

# 4. SYSTEM
RUST_LOG=info,trading_bot=debug

# 5. DATABASE (POSTGRESQL)
# Catatan: Jika pakai Docker Compose, host-nya adalah 'postgres'
DATABASE_URL=postgres://cj:cj123@postgres:5432/trading_bot
